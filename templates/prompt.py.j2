#!/usr/bin/python3 -I
"""Print the Juju-managed shell prompt on stdout.

Generated by the prompt-highlighter charm -- do not edit by hand, any change is
overwritten by the next config-changed hook.

Usage: juju_dynamic_prompt.py [bash|zsh] [exit-status]

The shebang names the system interpreter outright and runs it in isolated mode:
this script runs as whoever is at the keyboard, root included, inside that
user's own environment, so neither their PATH nor their PYTHONPATH, PYTHON*
variables or user site-packages may decide what code it executes.
"""

import os
import re
import sys

BADGE_LABEL = {{ label | tojson }}
BADGE_COLOR = {{ color | tojson }}
JUJU_MODEL = {{ juju_model | tojson }}
PRINCIPAL_DIR = {{ principal_dir | tojson }}
# The layout of the context after the badge: "$model", "$units" and
# "$hostname" (or "${model}" etc.) are replaced, everything else is shown as
# written. Resolved here rather than in the charm because two of the three
# fields are only known at prompt time.
PROMPT_TEMPLATE = {{ prompt_template | tojson }}
# Cursor on its own line below the context (True), or everything on one line.
MULTI_LINE = {{ "True" if multi_line else "False" }}

# How many principal units to name before summarising the rest. This is the
# longest field and the least urgent one, so it is the first to be cut.
MAX_PRINCIPALS = 2

RESET = "\033[0m"

# The label is drawn as a filled block rather than bracketed text.
# A block of colour registers before it is read, and it still reads as reverse
# video on a terminal with no colour at all -- which bracketed text does not.
# These are the basic background codes (40-47 and 100), so they land correctly
# on any ANSI terminal rather than only on 256-colour ones.
BADGES = {
    "red": "\033[41m\033[97m",
    "green": "\033[42m\033[30m",
    "yellow": "\033[43m\033[30m",
    "blue": "\033[44m\033[97m",
    "magenta": "\033[45m\033[97m",
    "cyan": "\033[46m\033[30m",
    "white": "\033[47m\033[30m",
    "grey": "\033[100m\033[97m",
}

# Everything that is not the badge is deliberately quieter than the badge, so
# that the label keeps the attention it is there to claim. The principal list is
# the longest field and gets the dimmest colour of the three.
MODEL_COLOR = "\033[38;5;111m"
UNITS_COLOR = "\033[38;5;245m"
HOST_COLOR = "\033[38;5;150m"
FIELD_COLORS = {
    "model": MODEL_COLOR,
    "units": UNITS_COLOR,
    "hostname": HOST_COLOR,
}
CWD_COLOR = "\033[38;5;80m"
USER_COLOR = "\033[1;38;5;203m"
SEPARATOR_COLOR = "\033[38;5;238m"
FAILURE_COLOR = "\033[1;38;5;196m"
SYMBOL_COLOR = "\033[38;5;203m"

# Terminals with no title bar to set. On a serial or virsh console the sequence
# would at best be ignored, so it is not written there at all.
TITLELESS_TERMS = frozenset(
    ("", "dumb", "linux", "cons25", "vt100", "vt102", "vt220", "ansi")
)

# Delimiters that mark a zero-width region of the prompt. Without them the shell
# counts the escape sequences as printable characters and wraps long command
# lines in the wrong column.
NON_PRINTING = {
    "bash": ("\\[", "\\]"),
    "zsh": ("%{", "%}"),
}

FAILURE_GLYPH = "✗"
# What to show instead of a glyph the output encoding cannot carry. A unit whose
# locale is plain C cannot encode U+00B7, and a replacement character in every
# prompt is worse than an honest hyphen. Anything not listed becomes "?".
ASCII_STAND_INS = {
    "·": "-",
    "✗": "x",
}

# "$name" or "${name}" in the prompt template. The charm has already refused any
# name it does not know, so an unknown one here can only come from hand-editing
# this file; it is shown literally rather than left to crash the shell's prompt.
PLACEHOLDER = re.compile(r"\$(?:\{(\w+)\}|(\w+))")


def encodable(text):
    """Return text with every character the output encoding cannot carry replaced."""
    encoding = sys.stdout.encoding or "ascii"
    try:
        text.encode(encoding)
        return text
    except (UnicodeError, LookupError):
        pass
    degraded = []
    for char in text:
        try:
            char.encode(encoding)
            degraded.append(char)
        except (UnicodeError, LookupError):
            degraded.append(ASCII_STAND_INS.get(char, "?"))
    return "".join(degraded)


def parse_template(template):
    """Split the template into ("literal", text) and ("field", name) pieces."""
    pieces = []
    position = 0
    for match in PLACEHOLDER.finditer(template):
        if match.start() > position:
            pieces.append(("literal", template[position : match.start()]))
        pieces.append(("field", match.group(1) or match.group(2)))
        position = match.end()
    if position < len(template):
        pieces.append(("literal", template[position:]))
    return pieces


def context_pieces(values):
    """Return the (kind, colour, text) pieces of the context line, in order.

    A field that is not known -- most often the principal units, before the
    juju-info relation has joined -- is dropped together with the literal text
    between it and the previous field, rather than left behind as a blank gap.
    When it is the first field there is no such text, so the text between it
    and the next field goes instead.
    """
    kept = []
    seen_field = False
    drop_next_literal = False
    for kind, text in parse_template(PROMPT_TEMPLATE):
        if kind == "literal":
            if drop_next_literal:
                drop_next_literal = False
            else:
                kept.append((kind, SEPARATOR_COLOR, text))
            continue
        if text not in values:
            kept.append(("literal", SEPARATOR_COLOR, "$" + text))
            continue
        if values[text]:
            kept.append((kind, FIELD_COLORS[text], values[text]))
            seen_field = True
        elif seen_field:
            if kept and kept[-1][0] == "literal":
                kept.pop()
        else:
            drop_next_literal = True
    return kept


def printable(char):
    """Return True for a character that is safe to send to a terminal.

    Excludes the C0 controls and DEL, and the C1 range, which some terminals
    still decode as control sequences even under a UTF-8 locale.
    """
    return " " <= char != "\x7f" and not ("\x80" <= char <= "\x9f")


def quote(text, shell):
    """Make text safe to place inside a shell prompt string.

    A prompt string is re-expanded by the shell every time the prompt is drawn,
    so a ``$(...)`` or a backtick arriving from a directory name, a hostname or
    $USER would be *executed*, as whoever is at the keyboard. Anyone who can
    create a directory can therefore name it into a command that runs the
    moment root cd's into it. Control characters would likewise reach the
    terminal as escape sequences rather than as text. Neither gets through.
    """
    text = encodable("".join(char if printable(char) else "?" for char in text))
    if shell == "bash":
        # Bash makes two passes over a prompt: it decodes backslash escapes
        # (\u, \w, \\ ...) first, and then -- with promptvars set, which it is
        # by default -- expands the result as if it were inside double quotes.
        # Every character that is special in double quotes ($, `, " and \
        # itself) must therefore arrive at the second pass with a backslash in
        # front of it, and that backslash has to be written as "\\" to come
        # through the first pass at all. So "$" becomes "\\$" and a lone "\"
        # becomes "\\\\"; anything less leaves a "\$(...)" in a directory name
        # to run as a command. Backslashes go first, or the ones added for the
        # other characters would be doubled up too.
        text = text.replace("\\", "\\\\\\\\")
        for special in "$`\"":
            text = text.replace(special, "\\\\" + special)
        return text
    if shell == "zsh":
        # Zsh expands "$" and "`" only when PROMPT_SUBST is set, which is the
        # operator's own choice and unknowable here, and the backslash that
        # would neutralise them shows up literally when it is not set.
        # Replacing them is the only answer that is right either way.
        text = text.replace("%", "%%")
        return text.replace("$", "?").replace("`", "?")
    return text


def current_user():
    for var in ("USER", "LOGNAME", "USERNAME"):
        value = os.environ.get(var)
        if value:
            return value
    return "user"


def current_principals():
    """Return the Juju principal units sharing this machine, comma separated.

    Read at prompt time, not baked in: Juju runs one subordinate unit per
    principal unit, so a machine hosting several principals has several
    subordinate units, each dropping its own record here. Reading the directory
    means a principal added or removed later shows up in shells that are
    already open.

    Past MAX_PRINCIPALS the tail is summarised rather than listed, so that a
    machine with a long stack of principals cannot push the cursor off screen.
    """
    try:
        entries = sorted(os.listdir(PRINCIPAL_DIR))
    except OSError:
        return ""
    names = set()
    for entry in entries:
        try:
            with open(os.path.join(PRINCIPAL_DIR, entry)) as handle:
                name = handle.read().strip()
        except OSError:
            continue
        if name:
            names.add(name)
    ordered = sorted(names)
    if len(ordered) <= MAX_PRINCIPALS:
        return ",".join(ordered)
    hidden = len(ordered) - MAX_PRINCIPALS
    return ",".join(ordered[:MAX_PRINCIPALS]) + " +" + str(hidden) + " more"


def current_hostname():
    """Return this machine's or container's hostname.

    Read at prompt time rather than baked in at render time, so a renamed host
    or a container cloned from an image reports itself correctly.
    """
    try:
        return os.uname().nodename or "unknown-host"
    except OSError:
        return "unknown-host"


def current_directory():
    try:
        cwd = os.getcwd()
    except OSError:
        return "?"
    home = os.path.expanduser("~")
    if home != "~" and cwd == home:
        return "~"
    if home != "~" and cwd.startswith(home + os.sep):
        return "~" + cwd[len(home):]
    return cwd


def window_title_text(context):
    """Return the text for the terminal window title, or "" if it has no title.

    The sequence is written by the shell on this unit but interpreted by the
    operator's *local* terminal emulator, so the title follows a plain ssh or a
    `juju ssh` all the way back to the window the operator is looking at.
    """
    if os.environ.get("TERM", "") in TITLELESS_TERMS:
        return ""
    # Control characters would end the sequence early and spill the rest of the
    # title onto the screen as literal text; quote() takes them out on the way
    # into the prompt, along with everything the shell would expand.
    return ("[" + BADGE_LABEL.upper() + "] " + context).rstrip()


def render(shell, exit_status):
    """Return the prompt: the context, then the cursor below it or after it."""
    open_, close = NON_PRINTING.get(shell, ("", ""))

    def raw(sequence):
        """Mark an escape sequence zero-width so the shell does not count it."""
        return open_ + sequence + close

    def painted(color, text):
        return raw(color) + quote(text, shell) + raw(RESET)

    badge = BADGES.get(BADGE_COLOR.lower(), BADGES["green"])
    label = (
        raw(badge + "\033[1m")
        + " "
        + quote(BADGE_LABEL.upper(), shell)
        + " "
        + raw(RESET)
    )

    pieces = context_pieces(
        {
            "model": JUJU_MODEL,
            "units": current_principals(),
            "hostname": current_hostname(),
        }
    )
    context = "".join(painted(color, text) for _, color, text in pieces)

    if exit_status:
        context += (
            "  "
            + raw(FAILURE_COLOR)
            + encodable(FAILURE_GLYPH)
            + " "
            + str(exit_status)
            + raw(RESET)
        )

    # The Unix convention, and a free signal that costs no columns.
    symbol = "#" if os.geteuid() == 0 else "$"
    cursor = (
        painted(USER_COLOR, current_user())
        + " "
        + painted(CWD_COLOR, current_directory())
        + " "
        + raw(SYMBOL_COLOR)
        + symbol
        + raw(RESET)
        + " "
    )

    title_text = window_title_text("".join(text for _, _, text in pieces))
    title = ""
    if title_text:
        title = raw("\033]0;" + quote(title_text, shell) + "\007")

    # An empty context -- a badge-only template with nothing to flag -- gets
    # no joining space, so the badge is not followed by a stray blank.
    line = label + " " + context if context else label
    between = "\n" if MULTI_LINE else " "
    return title + line + between + cursor


if __name__ == "__main__":
    shell = sys.argv[1] if len(sys.argv) > 1 else "bash"
    try:
        status = int(sys.argv[2]) if len(sys.argv) > 2 else 0
    except ValueError:
        status = 0
    sys.stdout.write(render(shell, status))
