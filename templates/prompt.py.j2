#!/usr/bin/env python3
import os
import sys

COLOR_MAP = {
    "red": "\033[0;31m",
    "green": "\033[0;32m",
    "yellow": "\033[0;33m",
    "blue": "\033[0;34m",
    "reset": "\033[0m"
}

def get_prompt():
    env_label = "{{ environment_type }}".upper()
    chosen_color = "{{ prompt_color }}".lower()
    
    color = COLOR_MAP.get(chosen_color, COLOR_MAP["green"])
    reset = COLOR_MAP["reset"]
    
    user = os.getenv("USER", "user")
    cwd = os.getcwd()
    
    return f"{color}[{env_label}] {user}:{cwd}$ {reset}"

if __name__ == "__main__":
    sys.stdout.write(get_prompt())
