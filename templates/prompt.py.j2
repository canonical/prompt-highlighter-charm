#!/usr/bin/env python3
"""Print the Juju-managed shell prompt on stdout.

Generated by the prompt-highlighter charm -- do not edit by hand, any change is
overwritten by the next config-changed hook.

Usage: juju_dynamic_prompt.py [bash|zsh]
"""

import os
import sys

ENVIRONMENT_LABEL = {{ environment_type | tojson }}
PROMPT_COLOR = {{ prompt_color | tojson }}

COLORS = {
    "red": "\033[0;31m",
    "green": "\033[0;32m",
    "yellow": "\033[0;33m",
    "blue": "\033[0;34m",
    "magenta": "\033[0;35m",
    "cyan": "\033[0;36m",
    "white": "\033[0;37m",
}
RESET = "\033[0m"

# Delimiters that mark a zero-width region of the prompt. Without them the shell
# counts the escape sequences as printable characters and wraps long command
# lines in the wrong column.
NON_PRINTING = {
    "bash": ("\\[", "\\]"),
    "zsh": ("%{", "%}"),
}


def quote(text, shell):
    """Escape characters the shell would otherwise expand inside the prompt."""
    if shell == "bash":
        return text.replace("\\", "\\\\")
    if shell == "zsh":
        return text.replace("%", "%%")
    return text


def current_user():
    for var in ("USER", "LOGNAME", "USERNAME"):
        value = os.environ.get(var)
        if value:
            return value
    return "user"


def current_directory():
    try:
        cwd = os.getcwd()
    except OSError:
        return "?"
    home = os.path.expanduser("~")
    if home != "~" and cwd == home:
        return "~"
    if home != "~" and cwd.startswith(home + os.sep):
        return "~" + cwd[len(home):]
    return cwd


def render(shell):
    open_, close = NON_PRINTING.get(shell, ("", ""))
    color = COLORS.get(PROMPT_COLOR.lower(), COLORS["green"])
    label = quote(ENVIRONMENT_LABEL.upper(), shell)
    user = quote(current_user(), shell)
    cwd = quote(current_directory(), shell)
    return (
        open_ + color + close
        + "[" + label + "] " + user + ":" + cwd + "$ "
        + open_ + RESET + close
    )


if __name__ == "__main__":
    shell = sys.argv[1] if len(sys.argv) > 1 else "bash"
    sys.stdout.write(render(shell))
